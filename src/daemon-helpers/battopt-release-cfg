#!/bin/bash
# Sets top-level limit_enable = 0 in battopt_cfg
CFG="/Library/Application Support/battopt/battopt_cfg"
[ -f "$CFG" ] || { echo "CFG_NOT_FOUND"; exit 1; }

/usr/bin/python3 <<PYEOF
cfg = "$CFG"
with open(cfg, 'rb') as f:
    c = f.read()
needle = b'limit_enable = 1'
if c.startswith(needle):
    c = b'limit_enable = 0' + c[len(needle):]
    with open(cfg, 'wb') as f:
        f.write(c)
    print("RELEASED")
else:
    print("already_released" if c.startswith(b'limit_enable = 0') else "no_match")
PYEOF
