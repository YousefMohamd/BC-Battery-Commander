# Battery Commander sudoers (W5.1/W5.2) - pmset ONLY.
#
# Replaces src/sudoers/battopt (783 B, 13 lines), which granted the whole
# battopt binary, /bin/launchctl, /usr/bin/pkill + killall as root, pmset,
# and rm -f .../.sys_info (the trial-renew enabler). BC needs none of that:
# the only passwordless root call BC makes is pmset (sleep/power modes),
# and only via `sudo -n /usr/bin/pmset` (W1.9, W4.3).
#
# DO NOT INSTALL IN W5. Installation is a USER deploy step (after W6.4):
#   sudo cp src/sudoers/battery-commander /etc/sudoers.d/battery-commander
#   sudo chown root:wheel /etc/sudoers.d/battery-commander
#   sudo chmod 440 /etc/sudoers.d/battery-commander
#   sudo visudo -c -f /etc/sudoers.d/battery-commander
# and the old /etc/sudoers.d/battopt is removed at the same deploy step
# (after the installed copy is read once on the Mac to confirm it matches
# the repo copy - that read is still owed, decision 8).
#
# NOTE: the username below is a placeholder. The deploy step substitutes
# the actual username (the file must name the user it applies to).
Yousef ALL=(root) NOPASSWD: /usr/bin/pmset, /usr/sbin/pmset
