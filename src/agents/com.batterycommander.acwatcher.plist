<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.batterycommander.acwatcher</string>
    <key>ProgramArguments</key>
    <array><string>@HOME@/.battery-commander/ac_watcher.sh</string></array>
    <key>StartInterval</key><integer>30</integer>
    <key>RunAtLoad</key><true/>
    <key>StandardErrorPath</key><string>/tmp/batterycommander-acwatcher.err</string>
    <key>StandardOutPath</key><string>/tmp/batterycommander-acwatcher.out</string>
</dict>
</plist>
