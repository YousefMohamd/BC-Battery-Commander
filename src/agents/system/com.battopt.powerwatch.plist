<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>HOME</key>
		<string>/Users/Yousef</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.battopt.powerwatch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/Yousef/.battopt-swiftbar/powerwatch</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/var/log/powerwatch.err</string>
	<key>StandardOutPath</key>
	<string>/var/log/powerwatch.log</string>
</dict>
</plist>
